{
    "name": "colorrage/laravel-autoresponder",
    "description": "Full email marketing suite for Laravel: autoresponder sequences, email campaigns, mailer lists, tracking, and unsubscribes.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "autoresponder",
        "email",
        "drip",
        "campaign",
        "mailer"
    ],
    "authors": [
        {
            "name": "Colorrage",
            "email": "hello@colorrage.ro"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/mail": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/queue": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "ColorrageAR\\Autoresponder\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ColorrageAR\\Autoresponder\\Tests\\": "tests/",
            "App\\": "tests/Support/App/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ColorrageAR\\Autoresponder\\AutoresponderServiceProvider"
            ],
            "aliases": {
                "Autoresponder": "ColorrageAR\\Autoresponder\\Facades\\Autoresponder"
            }
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-text"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}