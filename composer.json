{
    "name": "cmr-management/laravel-autoresponder",
    "description": "Full email marketing suite for Laravel: autoresponder sequences, email campaigns, mailer lists, tracking, and unsubscribes.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "autoresponder", "email", "drip", "campaign", "mailer"],
    "authors": [
        {
            "name": "CMR Management",
            "email": "contact@cmr-management.eu"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "illuminate/mail": "^10.0|^11.0|^12.0",
        "illuminate/queue": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/console": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "CmrManagement\\Autoresponder\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CmrManagement\\Autoresponder\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "CmrManagement\\Autoresponder\\AutoresponderServiceProvider"
            ],
            "aliases": {
                "Autoresponder": "CmrManagement\\Autoresponder\\Facades\\Autoresponder"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
